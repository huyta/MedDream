# ==========================================
# MedDream Git Ignore Configuration
# ==========================================

# Secrets & Environment configuration
.env

# License files (avoid publishing private licenses)
license/*
!license/.gitkeep

# Large raw test DICOM folders & storage
Dicoms/
orthanc-data/
orthanc-db/

# macOS / OS metadata
.DS_Store
.AppleDouble
.LSOverride
._*

# Editor / IDE artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# Node.js dependencies & logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm/
